# Public site URL (canonical links, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://eliongroup.co

# Contact form — Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are delivered (comma-separate several addresses)
CONTACT_TO_EMAIL=info@eliongroup.co
# Sender; must be on a domain verified in Resend
CONTACT_FROM_EMAIL=ELION GROUP <website@eliongroup.co>

# Admin panel (/admin) — manage the team and the blog
# Password for signing in. Use a long, unique password.
ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: key used to sign the login cookie (any long random string).
# Without it, the key is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Supabase Storage: where team members, articles and all uploaded images are stored.
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# service_role key (Supabase → Project Settings → API Keys → Legacy). Server only: never expose it.
SUPABASE_SECRET_KEY=
# Public storage bucket name (default: cms)
SUPABASE_BUCKET=cms
# Without SUPABASE_URL and SUPABASE_SECRET_KEY (local development), content is saved in the ./.data folder.
